# Twala API base address. Staging is for Twala's own QA; customers use
# https://api.twala.ai/api/v1 with a test key.
TWALA_API_BASE=https://api-stage.twala.ai/api/v1

# An API key from Twala: Apps → your App → API keys. Use a test key
# (twk_test_…). A live key is refused unless ALLOW_LIVE_KEY=true.
TWALA_API_KEY=

# ALLOW_LIVE_KEY=false

# Port of the app's own server. The web UI proxies /api to it.
PORT=3180

# How many API calls the log keeps in memory.
API_LOG_LIMIT=200
